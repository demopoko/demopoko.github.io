async function startMintManual() {
  let ordered = getAllSelectedLayersInOrder();
  if (!ordered.length) {
    showToast('⚠️ প্রথমে লেয়ার সিলেক্ট করুন');
    return;
  }

  let requestedTotal = Math.min(MAX_NFT_LIMIT, parseInt(document.getElementById('total-nft-count').value) || 1);
  let startTokenId = parseInt(document.getElementById('start-token-id').value) || 1;
  let prefix = document.getElementById('name-prefix').value.trim() || "PUNK#";
  let desc = document.getElementById('nft-description').value;

  let btn = document.getElementById('bulk-mint-btn');
  btn.disabled = true;

  let progWrap = document.getElementById('progress-wrap');
  progWrap.classList.remove('hidden');
  let progFill = document.getElementById('progress-fill');
  let progCounter = document.getElementById('progress-counter');
  let progText = document.getElementById('progress-text');
  let progEta = document.getElementById('progress-eta');

  let newNFTs = [];
  let startTime = Date.now();
  let usedCombos = new Set();
  let possibleCombos = calculatePossibleCombos();

  for (let idx = 0; idx < requestedTotal; idx++) {
    let tokenId = startTokenId + idx;
    let percent = Math.round(((idx + 1) / requestedTotal) * 100);

    if (idx > 0) {
      let elapsed = (Date.now() - startTime) / 1000;
      let rate = idx / elapsed;
      let remaining = (requestedTotal - idx) / rate;
      progEta.innerText = `⏱ ETA: ${Math.round(remaining)}s`;
    }

    let picked, comboKey, attempts = 0;
    let map = getSelectedLayersByFolder();
    do {
      picked = pickRandomLayerSet(map);
      comboKey = picked.map(l => l.folder + ':' + l.id).join('|');
      attempts++;
    } while (usedCombos.has(comboKey) && attempts < 30 && usedCombos.size < possibleCombos);
    usedCombos.add(comboKey);

    let finalLayers = picked.map(l => ({ ...l }));
    let svgString = compositeSVG(finalLayers);
    let attributes = buildNFTAttributes(finalLayers);

    newNFTs.push({
      id: Date.now() + '_' + Math.random().toString(36).substr(2, 8) + '_' + idx,
      name: `${prefix}${tokenId}`,
      description: desc,
      svg: svgString,
      image: 'data:image/svg+xml;base64,' + btoa(svgString),
      attributes: attributes,
      layers: finalLayers.map(l => ({ traitType: l.traitType, traitValue: l.traitValue, svg: l.svg, folder: l.folder })),
      tokenIdRef: tokenId,
      baseUsed: 'manual',
      createdAt: new Date().toISOString()
    });

    progText.innerText = `🎯 #${tokenId}`;
    progCounter.innerText = `${idx+1}/${requestedTotal}`;
    progFill.style.width = `${percent}%`;

    if (idx % 10 === 0) await new Promise(r => setTimeout(r, 5));
  }

  nfts.push(...newNFTs);
  await updateNFTsInStorage();
  renderCollection();

  showToast(`✅ ${newNFTs.length} NFTs created locally!`);
  btn.disabled = false;
  progWrap.classList.add('hidden');
}

function downloadAllSVG() {
  if (!nfts.length) { showToast('No NFTs found!'); return; }
  const btn = document.querySelector('button[onclick*="downloadAllSVG"]');
  btn.disabled = true;
  const originalText = btn.textContent;
  btn.textContent = '📦 ZIPPING...';
  try {
    const zip = new JSZip();
    const folder = zip.folder('nfts_svg');
    nfts.forEach((nft, i) => {
      const fileName = `${i + 1}.svg`;
      let svgText = nft.svg || '';
      if (svgText.startsWith('data:image/svg+xml;base64,')) {
        svgText = atob(svgText.replace('data:image/svg+xml;base64,', ''));
      }
      folder.file(fileName, svgText);
    });
    zip.generateAsync({ type: 'blob' }).then(content => {
      saveAs(content, `nfts_svg_${Date.now()}.zip`);
      showToast(`✅ ${nfts.length} SVGs downloaded!`);
      btn.disabled = false;
      btn.textContent = originalText;
    });
  } catch(err) {
    console.error(err);
    showToast('❌ ZIP creation failed: ' + err.message);
    btn.disabled = false;
    btn.textContent = originalText;
  }
}

