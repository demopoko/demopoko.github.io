<script>
const FOLDERS = [
  'Background', 'Bones', 'Cloak', 'Crown', 'Palette', 'Relic', 'Sight', 'Artifact'
];

const FOLDER_LABELS = {
  Background: 'Background',
  Bones: 'Bones',
  Cloak: 'Cloak',
  Crown: 'Crown',
  Palette: 'Palette',
  Relic: 'Relic',
  Sight: 'Sight',
  Artifact: 'Artifact'
};

const MAX_NFT_LIMIT = 10000;

function showToast(m) {
  let t = document.getElementById('toast');
  t.innerText = m;
  t.classList.remove('hidden');
  clearTimeout(window.tt);
  window.tt = setTimeout(() => t.classList.add('hidden'), 3000);
}

function populateFolderDropdown() {
  let sel = document.getElementById('layer-folder');
  if (!sel) return;
  sel.innerHTML = FOLDERS.map(f => `<option value="${f}">${FOLDER_LABELS[f]}</option>`).join('');
}

// ============================================================
// FIREBASE & LOCAL STORAGE (NFTs লোকাল স্টোরেজে এবং লেয়ার ফায়ারবেইসে)
// ============================================================
const firebaseConfig = {
  apiKey: "AIzaSyAzyWZLtzpysvn6nxk8pN96gLsfMS2oL2M",
  authDomain: "leyerspunk.firebaseapp.com",
  databaseURL: "https://leyerspunk-default-rtdb.firebaseio.com",
  projectId: "leyerspunk",
  storageBucket: "leyerspunk.firebasestorage.app",
  messagingSenderId: "828318849186",
  appId: "1:828318849186:web:b1f4358e613e79de7f1ffb"
};
firebase.initializeApp(firebaseConfig);
const database = firebase.database();

let layersByFolder = {};
let selectedLayers = [];
let nfts = [], filteredNFTs = null;
let openFolder = null;
let globalSelectionCounter = 1; // সিরিয়াল ১ থেকে শুরু করার জন্য

FOLDERS.forEach(f => {
  layersByFolder[f] = [];
});

function escapeHtml(str) {
  if (!str) return '';
  return str.replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]||m));
}

// NFT গুলো লোকাল স্টোরেজে সেভ করার ফাংশন (ক্র্যাশ এড়াতে)
async function saveNFTsToLocalStorage() {
  try { 
    localStorage.setItem('404punks_local_nfts', JSON.stringify(nfts)); 
  } catch(e) { 
    console.error(e); 
    showToast('⚠️ Storage limit reached!');
  }
}

async function updateNFTsInStorage() {
  await saveNFTsToLocalStorage();
}

async function loadNFTsFromStorage() {
  try {
    const local = localStorage.getItem('404punks_local_nfts');
    nfts = local ? JSON.parse(local) : [];
    renderCollection();
  } catch(e) {
    nfts = [];
    renderCollection();
  }
}

function listenFirebase() {
  database.ref('layers_svg').on('value', snap => {
    let d = snap.val();
    if (d) {
      FOLDERS.forEach(f => {
        layersByFolder[f] = d[f] || [];
      });
    } else {
      FOLDERS.forEach(f => layersByFolder[f] = []);
    }
    renderSections();
    renderCreateSections();
  });
}

async function addLayerToFirebase(folder, layer) {
  let arr = [...layersByFolder[folder], layer];
  await database.ref(`layers_svg/${folder}`).set(arr);
  showToast(`ADDED: ${layer.traitValue}`);
}

async function deleteLayerFromFirebase(folder, id) {
  let filtered = layersByFolder[folder].filter(l => String(l.id) !== String(id));
  await database.ref(`layers_svg/${folder}`).set(filtered);
  showToast('LAYER DELETED');
}

async function updateLayerInFirebase(folder, id, newTraitType, newTraitValue, newSvg) {
  let arr = layersByFolder[folder].map(l => {
    if (String(l.id) === String(id)) {
      return { ...l, traitType: newTraitType, traitValue: newTraitValue, svg: newSvg };
    }
    return l;
  });
  await database.ref(`layers_svg/${folder}`).set(arr);
  showToast('LAYER UPDATED');
}

function toggleLayerSelection(layerId) {
  let idx = selectedLayers.findIndex(l => l.id === layerId);
  if (idx !== -1) {
    selectedLayers.splice(idx, 1);
    // রিমুভ করার পর সিরিয়াল রি-অর্ডার করা
    recalculateSelectionOrder();
  } else {
    for (let f of FOLDERS) {
      let found = layersByFolder[f].find(l => l.id === layerId);
      if (found) {
        selectedLayers.push({
          id: found.id,
          folder: f,
          traitType: found.traitType,
          traitValue: found.traitValue,
          svg: found.svg,
          selectionOrder: globalSelectionCounter++
        });
        break;
      }
    }
  }
  renderCreateSections();
  updateLivePreview();
}

// সিলেক্ট করার ক্রমানুসারে সিরিয়াল ঠিক করার ফাংশন (1>2>3>4>5)
function recalculateSelectionOrder() {
  globalSelectionCounter = 1;
  selectedLayers.forEach(l => {
    l.selectionOrder = globalSelectionCounter++;
  });
}

// অর্ডার প্রিভিউ এর জন্য সিলেক্ট করার সিরিয়াল অনুযায়ী সাজানো
function getAllSelectedLayersInOrder() {
  return [...selectedLayers].sort((a, b) => (a.selectionOrder || 0) - (b.selectionOrder || 0));
}

function getSelectedLayersByFolder() {
  let map = {};
  FOLDERS.forEach(f => map[f] = []);
  selectedLayers.forEach(l => { if (map[l.folder]) map[l.folder].push(l); });
  return map;
}

function pickRandomLayerSet(map) {
  map = map || getSelectedLayersByFolder();
  let picked = [];
  // প্রথমে সিলেক্ট করা লেয়ারগুলো যেভাবে যোগ করা হয়েছে ঠিক সেই সিরিয়ালে থাকবে
  let orderedSelections = getAllSelectedLayersInOrder();
  let processedFolders = new Set();
  
  orderedSelections.forEach(l => {
    if(!processedFolders.has(l.folder)) {
      processedFolders.add(l.folder);
      let folderItems = map[l.folder];
      if(folderItems && folderItems.length) {
        picked.push(folderItems[Math.floor(Math.random() * folderItems.length)]);
      }
    }
  });
  return picked;
}

function calculatePossibleCombos() {
  let map = getSelectedLayersByFolder();
  let combos = 1, any = false;
  FOLDERS.forEach(f => {
    if (map[f].length > 0) { combos *= map[f].length; any = true; }
  });
  return any ? combos : 0;
}

function updateComboInfo() {
  let el = document.getElementById('combo-info');
  if (!el) return;
  let combos = calculatePossibleCombos();
  if (!combos) {
    el.innerHTML = '⚠️ কোনো লেয়ার সিলেক্ট করা হয়নি';
    return;
  }
  let requested = parseInt(document.getElementById('total-nft-count')?.value) || 0;
  let comboText = combos.toLocaleString();
  let warn = requested > combos
