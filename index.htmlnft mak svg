}

function searchNFTs() {
  let searchVal = document.getElementById('search-range').value.trim();
  if (!searchVal) { filteredNFTs = null; renderCollection(); return; }
  if (searchVal.includes('-')) {
    let parts = searchVal.split('-');
    let start = parseInt(parts[0]), end = parseInt(parts[1]);
    if (!isNaN(start) && !isNaN(end)) filteredNFTs = nfts.filter((_, idx) => { let n = idx+1; return n >= start && n <= end; });
    else { filteredNFTs = null; showToast('INVALID RANGE'); }
  } else {
    let single = parseInt(searchVal);
    if (!isNaN(single)) filteredNFTs = nfts.filter((_, idx) => (idx+1) === single);
    else filteredNFTs = null;
  }
  renderCollection();
}

function clearSearch() { filteredNFTs = null; document.getElementById('search-range').value = ''; renderCollection(); }

async function deleteAllNFTs() {
  if (confirm('⚠️ Delete ALL NFTs?')) {
    nfts = [];
    await updateNFTsInStorage();
    renderCollection();
    showToast('ALL NFTs DELETED');
  }
}

async function deleteSingleNFT(id) {
  if (confirm('Delete this NFT?')) {
    nfts = nfts.filter(x => x.id != id);
    await updateNFTsInStorage();
    renderCollection();
    showToast('NFT DELETED');
  }
}

function downloadSingleSVG(id, serial) {
  let n = nfts.find(x => x.id == id);
  if (n) {
    try {
      let svgText = n.svg || n.image || '';
      if (svgText.startsWith('data:image/svg+xml;base64,')) {
        svgText = atob(svgText.replace('data:image/svg+xml;base64,', ''));
      }
      let blob = new Blob([svgText], { type: 'image/svg+xml' });
      let a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `${serial || n.name.replace(/[^a-z0-9]/gi,'_')}.svg`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      setTimeout(() => URL.revokeObjectURL(a.href), 1000);
      showToast('SVG SAVED');
    } catch(e) {
      showToast('❌ Download failed: ' + e.message);
    }
  } else {
    showToast('❌ NFT not found');
  }
}

function downloadSingleJSON(id, serial) {
  let n = nfts.find(x => x.id == id);
  if (n) {
    try {
      let meta = { name: n.name, description: n.description, attributes: n.attributes };
      let blob = new Blob([JSON.stringify(meta, null, 2)], { type: 'application/json' });
      let a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `${serial || n.name.replace(/[^a-z0-9]/gi,'_')}.json`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      setTimeout(() => URL.revokeObjectURL(a.href), 1000);
      showToast('JSON SAVED');
    } catch(e) {
      showToast('❌ Download failed: ' + e.message);
    }
  } else {
    showToast('❌ NFT not found');
  }
}

async function addLayerSVG() {
  let folder = document.getElementById('layer-folder').value;
  let traitType = FOLDER_LABELS[folder];
  let traitValue = document.getElementById('trait-value').value.trim();
  let svgCode = document.getElementById('svg-code').value.trim();

  let fileInput = document.getElementById('svg-upload');
  if (fileInput.files.length > 0) {
    let file = fileInput.files[0];
    let reader = new FileReader();
    reader.onload = function(e) {
      svgCode = e.target.result;
      processAddLayer(folder, traitType, traitValue, svgCode);
    };
    reader.readAsText(file);
    return;
  }

  if (!folder || !traitValue || !svgCode) {
    showToast('⚠️ Category + trait value + SVG required');
    return;
  }
  processAddLayer(folder, traitType, traitValue, svgCode);
}

function processAddLayer(folder, traitType, traitValue, svgCode) {
  if (!FOLDERS.includes(folder)) {
    showToast('⚠️ Unknown category');
    return;
  }
  if (!svgCode.includes('<svg')) {
    showToast('⚠️ Invalid SVG code');
    return;
  }
  let newLayer = {
    id: Date.now()+'_'+Math.random().toString(36).substr(2,6),
    traitType: traitType,
    traitValue: traitValue,
    svg: svgCode
  };
  addLayerToFirebase(folder, newLayer);
  document.getElementById('svg-code').value = '';
  document.getElementById('svg-upload').value = '';
  document.getElementById('svg-preview').innerHTML = '';
  document.getElementById('trait-value').value = '';
}

document.getElementById('svg-upload').addEventListener('change', function(e) {
  let file = e.target.files[0];
  if (file) {
    let reader = new FileReader();
    reader.onload = function(ev) {
      document.getElementById('svg-preview').innerHTML = ev.target.result;
    };
    reader.readAsText(file);
  }
});

function switchTab(tab) {
  ['layers','create','collection'].forEach(t => {
    document.getElementById('panel-' + t).classList.toggle('hidden', t !== tab);
    document.getElementById('tab-' + t).classList.toggle('active', t === tab);
  });
  if (tab === 'create') { renderCreateSections(); updateLivePreview(); }
  if (tab === 'collection') renderCollection();
}

async function viewNFTDetails(id) {
 try {
  let nft = nfts.find(n => n.id === id);
  if (!nft) { showToast('⚠️ NFT not found'); return; }
  if (!nft.layers) nft.layers = [];

  let existingModal = document.getElementById('nft-modal-' + id);
  if (existingModal) existingModal.remove();

  let modal = document.createElement('div');
  modal.id = 'nft-modal-' + id;
  modal.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.8);display:flex;align-items:center;justify-content:center;z-index:10000;overflow:auto;padding:20px;';

  let layersHtml = nft.layers.map((l, idx) =>
    `<div class="layer-row"><span>${idx+1}. <strong>${l.traitType}</strong>: ${escapeHtml(l.traitValue)}</span>
    <div>
      <button onclick="App.editNFTLayer('${id}',${idx},'up')" class="move-btn">▲</button>
      <button onclick="App.editNFTLayer('${id}',${idx},'down')" class="move-btn">▼</button>
      <button onclick="App.deleteNFTLayer('${id}',${idx})" class="move-btn" style="border-color:#ff4444;">✕</button>
    </div></div>`
  ).join('');

  let libraryOptionsHtml = `<option value="">-- SELECT LAYER TO ADD --</option>`;
  FOLDERS.forEach(f => {
    let available = layersByFolder[f] || [];
    if(available.length > 0) {
      libraryOptionsHtml += `<optgroup label="📁 ${FOLDER_LABELS[f]}">`;
      available.forEach(l => {
        libraryOptionsHtml += `<option value="${f}|||${l.traitType}|||${l.traitValue}|||${escapeHtml(l.svg)}">${l.traitType} - ${l.traitValue}</option>`;
      });
      libraryOptionsHtml += `</optgroup>`;
    }
  });

  let svgDisplay = nft.svg || nft.image || '';
  if (svgDisplay.startsWith('data:image/svg+xml;base64,')) {
    svgDisplay = atob(svgDisplay.replace('data:image/svg+xml;base64,', ''));
  }

  modal.innerHTML = `<div class="win95-window" style="width:100%;max-width:500px;max-height:90vh;overflow:auto;">
    <div class="win95-titlebar"><span>✏️ EDIT: ${escapeHtml(nft.name)}</span><button onclick="document.getElementById('nft-modal-${id}').remove()">✕</button></div>
    <div class="win95-content">
      <div style="width:200px;height:200px;border:3px outset #808080;background:#fff;overflow:hidden;margin:0 auto 10px;">
        <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;">${svgDisplay}</div>
      </div>

      <div class="text-pixel text-[8px] mb-2" style="color:#000080;">➕ ADD LAYER FROM LIBRARY</div>
      <select id="add-layer-select-${id}" class="win95-select w-full mb-4" onchange="App.addLayerToNFT('${id}', this.value)">
        ${libraryOptionsHtml}
      </select>

      <div class="text-pixel text-[8px] mb-2">CURRENT LAYERS (Bottom → Top)</div>
      <div style="max-height:200px;overflow:auto;background:#a0a0a0;padding:6px;border:2px inset #808080;">${layersHtml || '<div class="text-center text-pixel text-[8px] py-4">[ NO LAYERS ]</div>'}</div>

      <div class="flex gap-3 mt-4">
        <button onclick="App.downloadSingleSVG('${id}');document.getElementById('nft-modal-${id}').remove()" class="win95-btn flex-1">📸 SVG</button>
        <button onclick="App.downloadSingleJSON('${id}');document.getElementById('nft-modal-${id}').remove()" class="win95-btn flex-1">📄 JSON</button>
      </div>
    </div></div>`;
  document.body.appendChild(modal);
 } catch(err) {
   console.error('viewNFTDetails error:', err);
   showToast('❌ Could not open EDIT: ' + err.message);
 }
}

async function addLayerToNFT(nftId, combinedValue) {
  if (!combinedValue) return;
  let nft = nfts.find(n => n.id === nftId);
  if (!nft) return;

  let [folder, traitType, traitValue, svg] = combinedValue.split('|||');
  if (!nft.layers) nft.layers = [];

  nft.layers.push({ traitType, traitValue, svg, folder });
  let svgString = compositeSVG(nft.layers);
  nft.svg = svgString;
  nft.image = 'data:image/svg+xml;base64,' + btoa(svgString);
  nft.attributes = buildNFTAttributes(nft.layers);

  await updateNFTsInStorage();
  renderCollection();
  showToast('LAYER ADDED');
  viewNFTDetails(nftId);
}

async function editNFTLayer(nftId, layerIndex, direction) {
  let nft = nfts.find(n => n.id === nftId);
  if (!nft || !nft.layers) return;
  let newLayers = [...nft.layers];
  if (direction === 'up' && layerIndex > 0) [newLayers[layerIndex], newLayers[layerIndex-1]] = [newLayers[layerIndex-1], newLayers[layerIndex]];
  else if (direction === 'down' && layerIndex < newLayers.length-1) [newLayers[layerIndex], newLayers[layerIndex+1]] = [newLayers[layerIndex+1], newLayers[layerIndex]];
  else return;
  nft.layers = newLayers;
  let svgString = compositeSVG(nft.layers);
  nft.svg = svgString;
  nft.image = 'data:image/svg+xml;base64,' + btoa(svgString);
  nft.attributes = buildNFTAttributes(nft.layers);
  await updateNFTsInStorage();
  renderCollection();
  showToast('LAYER MOVED');
  viewNFTDetails(nftId);
}

async function deleteNFTLayer(nftId, layerIndex) {
  let nft = nfts.find(n => n.id === nftId);
  if (!nft || !nft.layers) return;
  let removed = nft.layers[layerIndex];
  if (confirm(`DELETE "${removed.traitType}: ${removed.traitValue}"?`)) {
    nft.layers.splice(layerIndex, 1);
    let svgString = compositeSVG(nft.layers);
    nft.svg = svgString;
    nft.image = 'data:image/svg+xml;base64,' + btoa(svgString);
    nft.attributes = buildNFTAttributes(nft.layers);
    await updateNFTsInStorage();
    renderCollection();
    showToast('REMOVED');
    viewNFTDetails(nftId);
  }
}

window.App = {
