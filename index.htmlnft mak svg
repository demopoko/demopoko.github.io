function extractViewBox(svgString) {
  if (!svgString) return '0 0 512 512';
  let vbMatch = svgString.match(/viewBox\s*=\s*["']([^"']+)["']/i);
  if (vbMatch) return vbMatch[1].trim();
  let wMatch = svgString.match(/<svg[^>]*\swidth\s*=\s*["']?([\d.]+)/i);
  let hMatch = svgString.match(/<svg[^>]*\sheight\s*=\s*["']?([\d.]+)/i);
  if (wMatch && hMatch) return `0 0 ${wMatch[1]} ${hMatch[1]}`;
  return '0 0 512 512';
}

function extractInnerSVG(svgString) {
  if (!svgString) return '';
  let match = svgString.match(/<svg[^>]*>([\s\S]*)<\/svg>/i);
  return match ? match[1] : svgString;
}

function wrapLayerToSize(svgString, size) {
  let vb = extractViewBox(svgString);
  let inner = extractInnerSVG(svgString);
  return `<svg x="0" y="0" width="${size}" height="${size}" viewBox="${vb}" preserveAspectRatio="none">${inner}</svg>`;
}

function updateLivePreview() {
  let container = document.getElementById('svg-live-preview');
  if (!container) return;
  let ordered = getAllSelectedLayersInOrder();
  if (!ordered.length) {
    container.innerHTML = `<svg viewBox="0 0 24 24" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg"><rect width="24" height="24" fill="#f0f0f0"/><text x="3" y="14" font-family="monospace" font-size="4" fill="#666">Select</text></svg>`;
    return;
  }
  let sample = pickRandomLayerSet();
  let combined = `<svg viewBox="0 0 24 24" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">`;
  sample.forEach(l => {
    combined += wrapLayerToSize(l.svg, 24);
  });
  combined += `</svg>`;
  container.innerHTML = combined;
}

function compositeSVG(layers) {
  let combined = `<svg viewBox="0 0 512 512" width="512" height="512" xmlns="http://www.w3.org/2000/svg">`;
  layers.forEach(l => {
    combined += wrapLayerToSize(l.svg, 512);
  });
  combined += `</svg>`;
  return combined;
}

function buildNFTAttributes(layers) {
  let attrs = [];
  layers.forEach(l => {
    attrs.push({ trait_type: FOLDER_LABELS[l.folder], value: l.traitValue });
  });
  attrs.push({ trait_type: "Attribute Count", value: String(attrs.length) });
  return attrs;
}

function findLayerByTrait(traitType, traitValue) {
  if (!traitType || !traitValue) return null;
  const targetType = String(traitType).toLowerCase().trim();
  const targetVal = String(traitValue).toLowerCase().trim();
  for (let f of FOLDERS) {
    let found = layersByFolder[f].find(l =>
      String(l.traitType).toLowerCase().trim() === targetType &&
      String(l.traitValue).toLowerCase().trim() === targetVal
    );
    if (found) return found;
  }
  return null;
}

